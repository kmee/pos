<odoo>

    <record id="pos_discount_reason_rule" model="ir.rule">
        <field name="name">POS Discount Reason: All</field>
        <field name="model_id" ref="model_pos_discount_reason" />
        <field name="global" eval="True" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="access_pos_discount_reason_user" model="ir.model.access">
        <field name="name">pos.discount.reason user</field>
        <field name="model_id" ref="model_pos_discount_reason" />
        <field name="group_id" ref="point_of_sale.group_pos_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="access_pos_discount_reason_manager" model="ir.model.access">
        <field name="name">pos.discount.reason manager</field>
        <field name="model_id" ref="model_pos_discount_reason" />
        <field name="group_id" ref="point_of_sale.group_pos_manager" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

</odoo>
