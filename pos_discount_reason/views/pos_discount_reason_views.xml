<odoo>

    <record id="pos_discount_reason_view_list" model="ir.ui.view">
        <field name="name">pos.discount.reason.list</field>
        <field name="model">pos.discount.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="percent" />
                <field name="discount_use" />
            </list>
        </field>
    </record>

    <record id="pos_discount_reason_view_form" model="ir.ui.view">
        <field name="name">pos.discount.reason.form</field>
        <field name="model">pos.discount.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="percent" />
                        <field name="discount_use" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_discount_reason" model="ir.actions.act_window">
        <field name="name">Discount Reasons</field>
        <field name="res_model">pos.discount.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pos_discount_reason"
        name="Discount Reasons"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_discount_reason"
        sequence="30"
    />

</odoo>
