<odoo>

    <record id="pos_component_security_view_list" model="ir.ui.view">
        <field name="name">pos.component.security.list</field>
        <field name="model">pos.component.security</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="pos_component_security_view_form" model="ir.ui.view">
        <field name="name">pos.component.security.form</field>
        <field name="model">pos.component.security</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_component_security" model="ir.actions.act_window">
        <field name="name">POS Components</field>
        <field name="res_model">pos.component.security</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pos_component_security"
        name="POS Components"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_component_security"
        sequence="40"
    />

</odoo>
