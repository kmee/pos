<odoo>

    <record id="pos_employee_access_security_view_list" model="ir.ui.view">
        <field name="name">pos.employee.access.security.list</field>
        <field name="model">pos.employee.access.security</field>
        <field name="arch" type="xml">
            <list>
                <field name="pos_component_id" />
                <field name="pos_event_type" />
                <field name="job_position_id" />
                <field name="permission" />
            </list>
        </field>
    </record>

    <record id="pos_employee_access_security_view_form" model="ir.ui.view">
        <field name="name">pos.employee.access.security.form</field>
        <field name="model">pos.employee.access.security</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="pos_component_id" />
                        <field name="pos_event_type" />
                        <field name="pos_payload" />
                        <field name="job_position_id" />
                        <field name="permission" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_employee_access_security" model="ir.actions.act_window">
        <field name="name">Employee Access Rights</field>
        <field name="res_model">pos.employee.access.security</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pos_employee_access_security"
        name="Employee Access Rights"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_employee_access_security"
        sequence="41"
    />

</odoo>
