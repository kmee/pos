<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Activate MTO route -->
        <record id="stock.route_warehouse0_mto" model="stock.route">
            <field name="active">True</field>
        </record>

        <!-- Create a product with MTO + Manufacture routes -->
        <record id="product_pos_mrp_demo" model="product.product">
            <field name="name">POS MRP Demo Product</field>
            <field name="type">consu</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">100.0</field>
            <field
                name="route_ids"
                eval="[(6, 0, [ref('stock.route_warehouse0_mto'), ref('mrp.route_warehouse0_manufacture')])]"
            />
        </record>

        <!-- Component product for BOM -->
        <record id="product_component_demo" model="product.product">
            <field name="name">Component Demo Product</field>
            <field name="type">consu</field>
            <field name="list_price">25.0</field>
        </record>

        <!-- BOM for the demo product -->
        <record id="mrp_bom_pos_stock_mrp_demo" model="mrp.bom">
            <field name="product_tmpl_id" ref="product_pos_mrp_demo" />
            <field name="product_uom_id" ref="uom.product_uom_unit" />
            <field name="type">normal</field>
        </record>

        <record id="mrp_bom_line_demo" model="mrp.bom.line">
            <field name="product_id" ref="product_component_demo" />
            <field name="product_qty">1</field>
            <field name="product_uom_id" ref="uom.product_uom_unit" />
            <field name="bom_id" ref="mrp_bom_pos_stock_mrp_demo" />
        </record>
    </data>
</odoo>
